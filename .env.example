# ─── Database ───────────────────────────────────────────────────────────────
# DATABASE_URL: runtime app connection — least-privilege role, subject to RLS.
DATABASE_URL=postgresql://omnipos_app:omnipos_app@localhost:5432/omnipos_db
# DIRECT_DATABASE_URL: migration/DDL connection — owns the schema, bypasses RLS.
# Never point application code at this URL.
DIRECT_DATABASE_URL=postgresql://omnipos:omnipos@localhost:5432/omnipos_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another-long-random-string-for-refresh-tokens
JWT_REFRESH_EXPIRES_IN=30d

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ─── Dashboard ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
DASHBOARD_PORT=3001

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=default

# ─── Storage (future: S3-compatible for receipts / images) ───────────────────
# S3_BUCKET=omnipos-assets
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Billing: Stripe (global card payments + subscriptions) ──────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Billing: PayPal (global, Subscriptions API) ─────────────────────────────
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me

# ─── Billing: PayHere (Sri Lanka, LKR, one-time payment + our own scheduler) ─
PAYHERE_MERCHANT_ID=replace_me
PAYHERE_MERCHANT_SECRET=replace_me
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout

# Public base URL of the API (used to build PayHere notify_url/checkout-form links)
API_PUBLIC_URL=http://localhost:3000
