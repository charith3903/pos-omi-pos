  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, createdAt])
  @@map("held_sales")
}

// ─── Cash drawer / expense / paid-out ledger ──────────────────────────────────

enum CashMovementType {
  DRAWER_OPEN
  PAID_IN
  PAID_OUT
}

// RLS enabled
model CashMovement {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  outletId  String?          @map("outlet_id")
  shiftId   String           @map("shift_id")
  type      CashMovementType
  amount    Decimal          @default(0) @db.Decimal(12, 2)
  reason    String?
  createdBy String?          @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId, shiftId])
  @@map("cash_movements")
}

// ─── Warranty ────────────────────────────────────────────────────────────────

enum WarrantyClaimStatus {
  PENDING
  APPROVED
  REJECTED
  SENT_TO_SUPPLIER
  REPLACED
  REFUNDED
}

// RLS enabled
model WarrantyClaim {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  invoiceId String?             @map("invoice_id") @db.Uuid
  productId String              @map("product_id")
  serial    String?
  issue     String
  status    WarrantyClaimStatus @default(PENDING)
  notes     String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  product Product  @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
  @@map("warranty_claims")
}

// ─── Notifications (WhatsApp / SMS) ───────────────────────────────────────────

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// One row per tenant. Access tokens are stored encrypted at rest (see
// common/crypto.util.ts) — never returned in plaintext by the API; the
// service layer masks them on read.
// RLS enabled
model NotificationSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique @map("tenant_id")
  whatsappEnabled         Boolean  @default(false) @map("whatsapp_enabled")
  whatsappPhoneNumberId   String?  @map("whatsapp_phone_number_id")
  whatsappBusinessAcctId  String?  @map("whatsapp_business_account_id")
  whatsappAccessToken     String?  @map("whatsapp_access_token") // encrypted
  smsEnabled              Boolean  @default(false) @map("sms_enabled")
  smsApiToken             String?  @map("sms_api_token") // encrypted
  smsSenderName           String?  @map("sms_sender_name")
  autoSendReceiptWhatsapp Boolean  @default(false) @map("auto_send_receipt_whatsapp")
  autoSendReceiptSms      Boolean  @default(false) @map("auto_send_receipt_sms")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// Append-only send log for both channels.
// RLS enabled
model MessageLog {
  id                String         @id @default(cuid())
  tenantId          String         @map("tenant_id")
  channel           MessageChannel
  recipientPhone    String         @map("recipient_phone")
  body              String
  status            MessageStatus  @default(PENDING)
  providerMessageId String?        @map("provider_message_id")
  errorMessage      String?        @map("error_message")
  relatedInvoiceId  String?        @map("related_invoice_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [relatedInvoiceId], references: [id])

  @@index([tenantId, createdAt], name: "idx_message_logs_tenant_created")
  @@map("message_logs")
}

// ─── Billing & Subscriptions ──────────────────────────────────────────────────
// Deliberately separate from the POS `Invoice`/`Payment` models (which are
// sales records) to avoid any naming collision. `Plan`/`AddOnModule` are
// global catalogs with no RLS (like SyncLog — not tenant data). Subscription/
// SubscriptionAddOn/BillingTransaction are tenant-scoped and RLS-protected.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  PAYHERE
}

enum BillingTxnStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingCurrency {
  USD
  LKR
}

// No RLS — global catalog, one row per business type.
model Plan {
  id              String       @id @default(cuid())
  businessType    BusinessType @unique @map("business_type")
  name            String
  priceUsdMonthly Decimal      @map("price_usd_monthly") @db.Decimal(10, 2)
  priceUsdAnnual  Decimal?     @map("price_usd_annual") @db.Decimal(10, 2)
  priceLkrMonthly Decimal?     @map("price_lkr_monthly") @db.Decimal(10, 2)
  priceLkrAnnual  Decimal?     @map("price_lkr_annual") @db.Decimal(10, 2)
  trialDays       Int          @default(14) @map("trial_days")
  // Module keys bundled free with this plan (matches VerticalPack.enabledModules
  // keys, e.g. 'mobile', 'purchasing', 'warranty'). For Spare Parts at launch
  // this includes every module the pack defines — no paid add-ons yet.
  includedModules String[]     @map("included_modules")
  stripePriceId   String?      @map("stripe_price_id")
  paypalPlanId    String?      @map("paypal_plan_id")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

// No RLS — global catalog. Unused at launch (Spare Parts ships with
// everything in the base plan) but modeled now so future verticals can sell
// add-ons without another migration.
model AddOnModule {
  id                      String         @id @default(cuid())
  moduleKey               String         @unique @map("module_key")
  name                    String
  description             String?
  priceUsdMonthly         Decimal        @map("price_usd_monthly") @db.Decimal(10, 2)
  priceLkrMonthly         Decimal?       @map("price_lkr_monthly") @db.Decimal(10, 2)
  applicableBusinessTypes BusinessType[] @map("applicable_business_types")
  stripePriceId           String?        @map("stripe_price_id")
  paypalPlanId            String?        @map("paypal_plan_id")
  isActive                Boolean        @default(true) @map("is_active")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  subscriptionAddOns SubscriptionAddOn[]

  @@map("addon_modules")
}

// RLS enabled. 1:1 with Tenant — kept separate rather than embedded so
// gateway-id churn (renewals, webhooks) never touches the hot Tenant row.
model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique @map("tenant_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currency             BillingCurrency    @default(USD)
  gateway              PaymentGateway?
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  paypalSubscriptionId String?            @map("paypal_subscription_id")
  payhereMerchantId    String?            @map("payhere_merchant_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan                 @relation(fields: [planId], references: [id])
  addOns SubscriptionAddOn[]
  txns   BillingTransaction[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

// RLS enabled. Unused at launch (see AddOnModule) — schema ready for the
// next vertical.
model SubscriptionAddOn {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  subscriptionId       String    @map("subscription_id")
  addOnModuleId        String    @map("addon_module_id")
  status               String    @default("ACTIVE") // ACTIVE | CANCELLED
  activatedAt          DateTime  @default(now()) @map("activated_at")
  cancelledAt          DateTime? @map("cancelled_at")
  // Each add-on purchase creates its own independent gateway subscription
  // (not a "subscription item" on the tenant's main plan subscription) —
  // see PaymentsService.createAddOnCheckoutSession.
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  paypalSubscriptionId String?   @map("paypal_subscription_id")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addOnModule  AddOnModule  @relation(fields: [addOnModuleId], references: [id])

  @@unique([tenantId, addOnModuleId])
  @@index([tenantId, status])
  @@map("subscription_addons")
}

// RLS enabled. Payment history — audit trail for every gateway charge.
model BillingTransaction {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  subscriptionId String?          @map("subscription_id")
  gateway        PaymentGateway
  // Unique per gateway so duplicate webhook deliveries are a safe no-op.
  gatewayTxnId   String           @unique @map("gateway_txn_id")
  amount         Decimal          @db.Decimal(10, 2)
  currency       BillingCurrency
  status         BillingTxnStatus @default(PENDING)
  description    String?
  rawPayload     Json?            @map("raw_payload")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, createdAt])
  @@map("billing_transactions")
}
