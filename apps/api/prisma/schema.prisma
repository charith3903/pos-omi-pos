// ─── Held sales ("Hold Trans" / "Load Trans") ─────────────────────────────────

// RLS enabled
model HeldSale {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  outletId     String?  @map("outlet_id")
  customerId   String?  @map("customer_id")
  note         String?
  // Full in-progress cart: lines (incl. per-item discount/price overrides),
  // bill discount, draft payments, rate type — whatever the POS needs to
  // reconstruct the exact cart it was holding.
  cartSnapshot Json     @map("cart_snapshot")
